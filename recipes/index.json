   "steps": [
    {
     "text": "Zucker, Wasser und Zitronensaft in den Mixtopf geben und {S} kochen, ohne Messbecher, Garkörbchen als Spritzschutz auf den Deckel stellen.",
     "setting": {
      "time_s": 600,
      "temperature": "varoma",
      "speed": "1",
      "reverse": false,
      "mode": null,
      "accessory": null,
      "browning_power": null
     },
     "off_machine": false
    },
    {
     "text": "Sirup in eine Schüssel umfüllen, Orangenblütenwasser einrühren und abkühlen lassen. Mixtopf spülen und gut abtrocknen.",
     "setting": null,
     "off_machine": true
    },
    {
     "text": "Dattelpaste, Olivenöl, Zimt, Nelken und Orangenblütenwasser in den Mixtopf geben und {S} zu einer glatten Masse verarbeiten. Umfüllen.",
     "setting": {
      "time_s": 30,
      "temperature": null,
      "speed": "5",
      "reverse": false,
      "mode": null,
      "accessory": null,
      "browning_power": null
     },
     "off_machine": false
    },
    {
     "text": "Grieß, Olivenöl und Salz in den Mixtopf geben und {S} vermengen, bis der Grieß sandig ist.",
     "setting": {
      "time_s": 30,
      "temperature": null,
      "speed": "3",
      "reverse": true,
      "mode": null,
      "accessory": null,
      "browning_power": null
     },
     "off_machine": false
    },
    {
     "text": "Grieß 30 Min. im Mixtopf ruhen lassen, damit er das Öl aufnimmt.",
     "setting": null,
     "off_machine": true
    },
    {
     "text": "Wasser und Orangenblütenwasser zugeben und {S} zu einem weichen Teig verarbeiten – nicht zu lange kneten.",
     "setting": {
      "time_s": 60,
      "temperature": null,
      "speed": null,
      "reverse": false,
      "mode": "dough",
      "accessory": null,
      "browning_power": null
     },
     "off_machine": false
    },
    {
     "text": "Teig in 3 Portionen teilen, jede zu einer Rolle formen, längs eine Rinne drücken, Dattelmasse als dünne Rolle hineinlegen und den Teig darüber schließen. Leicht flach drücken und schräg in Rauten schneiden.",
     "setting": null,
     "off_machine": true
    },
    {
     "text": "Öl auf 170 °C erhitzen und die Makroudh portionsweise goldbraun frittieren.",
     "setting": null,
     "off_machine": true
    },
    {
     "text": "Noch heiß 1–2 Min. in den kalten Sirup legen, abtropfen lassen und nach Wunsch mit Sesam bestreuen.",
     "setting": null,
     "off_machine": true
    }
   ],
   "hints": [
