# Copy to .env and fill in. Never commit .env.

# --- AI that converts recipes (any provider) --------------------------------
# anthropic | openai | gemini | openrouter | groq | mistral | deepseek | ollama | lmstudio | custom
TUNIMIX_PROVIDER=anthropic
# Model id. List what's available with:  python -m tunimix models
#   anthropic: claude-sonnet-5-5   ollama: qwen3:8b / llama3.1:8b / gemma3:12b   openrouter: any id, e.g. ...:free
TUNIMIX_MODEL=
# Key for the chosen provider (or use ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY /
# OPENROUTER_API_KEY / GROQ_API_KEY / MISTRAL_API_KEY / DEEPSEEK_API_KEY). Not needed for ollama/lmstudio.
TUNIMIX_API_KEY=
ANTHROPIC_API_KEY=
# Only for custom endpoints or non-default addresses (e.g. Ollama on your NAS: http://192.168.178.20:11434)
TUNIMIX_BASE_URL=

# Language of converted recipes (de | fr | en) and your machine (TM5 | TM6 | TM7)
TUNIMIX_LANGUAGE=de
TUNIMIX_MACHINE=TM6

# --- Cookidoo (upload to "Meine Kreationen") -------------------------------
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=
COOKIDOO_COUNTRY=de
COOKIDOO_LANGUAGE=de-DE
# Seconds between uploads (the create endpoint rate-limits after ~6 per minute)
COOKIDOO_UPLOAD_DELAY=12

# --- Telegram bot (optional) -----------------------------------------------
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (send /id to the bot); comma-separated for family members
TELEGRAM_ALLOWED_USER_IDS=

# --- Web app (optional) ----------------------------------------------------
# Required if you run `tunimix web --host 0.0.0.0` to use it from your phone
TUNIMIX_WEB_TOKEN=
