# Copy to .env and fill in. Never commit .env.

# --- Claude (converts new recipes) -----------------------------------------
# https://console.anthropic.com -> API keys. Not needed for the MCP / Claude Desktop route.
ANTHROPIC_API_KEY=
TUNIMIX_MODEL=claude-sonnet-5-5

# Language of converted recipes (de | fr | en) and your machine (TM5 | TM6 | TM7)
TUNIMIX_LANGUAGE=de
TUNIMIX_MACHINE=TM6

# --- Cookidoo (upload to "Meine Kreationen") -------------------------------
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=
COOKIDOO_COUNTRY=de
COOKIDOO_LANGUAGE=de-DE
# Seconds between uploads (the create endpoint rate-limits after ~6 per minute)
COOKIDOO_UPLOAD_DELAY=12

# --- Telegram bot (optional) -----------------------------------------------
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (send /id to the bot); comma-separated for family members
TELEGRAM_ALLOWED_USER_IDS=

# --- Web app (optional) ----------------------------------------------------
# Required if you run `tunimix web --host 0.0.0.0` to use it from your phone
TUNIMIX_WEB_TOKEN=
