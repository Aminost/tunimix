  "steps": [
    {
      "text": "Paprika, Tomaten, Zwiebel und Chilis im Backofen (Grillfunktion, 250 °C) oder auf dem Grill rundum schwarz rösten (ca. 25 Min.). In eine Schüssel geben, abdecken, 10 Min. schwitzen lassen, dann häuten und entkernen.",
      "setting": null,
      "off_machine": true
    },
    {
      "text": "Kümmel- und Koriandersamen in den Mixtopf geben und {S} mahlen.",
      "setting": {
        "time_s": 20,
        "temperature": null,
        "speed": "10",
        "reverse": false,
        "mode": null,
        "accessory": null,
        "browning_power": null
      },
      "off_machine": false
    },
    {
      "text": "Knoblauch und Salz zugeben und {S} zerkleinern.",
      "setting": {
        "time_s": 4,
        "temperature": null,
        "speed": "5",
        "reverse": false,
        "mode": null,
        "accessory": null,
        "browning_power": null
      },
      "off_machine": false
    },
    {
      "text": "Geröstetes Gemüse zugeben und {S} grob zerkleinern – es soll stückig bleiben.",
      "setting": {
        "time_s": 4,
        "temperature": null,
        "speed": "4",
        "reverse": false,
        "mode": null,
        "accessory": null,
        "browning_power": null
      },
      "off_machine": false
    },
    {
      "text": "Olivenöl und Zitronensaft zugeben und {S} vermengen.",
      "setting": {
